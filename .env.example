# ==========================================
# CONFIGURACIÓN DE PRODUCCIÓN CURARE
# ==========================================

# Base de datos PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_NAME=curare
DB_USER=postgres
DB_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURO_EN_PRODUCCION

# Seguridad JWT
JWT_SECRET=CAMBIAR_POR_TOKEN_SUPER_SECRETO_EN_PRODUCCION_123456789

# Configuración Backend NestJS
NODE_ENV=production
PORT=3000

# URL de la API para el Frontend (Vite)
VITE_API_URL=/api
